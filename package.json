{
  "name": "tomzlab-web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev:folio": "vite --config folio-site/vite.config.ts",
    "build": "node scripts/prepare-site.mjs && python3 scripts/sync-source-index.py && vite build --config folio-site/vite.config.ts && node scripts/write-legacy-redirects.mjs && node scripts/check-built-site.mjs",
    "typecheck": "tsc -p folio-site/tsconfig.json",
    "check:built": "node scripts/check-built-site.mjs"
  },
  "dependencies": {
    "@uichat-mira/folio": "0.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  },
  "engines": {
    "node": ">=22.12"
  }
}
